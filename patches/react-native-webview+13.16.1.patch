+    // Android's photo picker (API 33+), when the input only takes images
+    // and/or videos; null otherwise. Needs no storage permission.
+    private Intent getMediaPickerIntent(String[] acceptTypes, boolean allowMultiple) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
+            return null;
+        }
+        boolean images = false;
+        boolean videos = false;
+        for (String raw : getAcceptedMimeType(acceptTypes)) {
+            String t = raw == null ? "" : raw.trim().toLowerCase();
+            if (t.isEmpty()) continue;
+            if (t.startsWith("image/")) images = true;
+            else if (t.startsWith("video/")) videos = true;
+            else return null;
+        }
+        if (!images && !videos) {
+            return null;
+        }
+        Intent intent = new Intent(MediaStore.ACTION_PICK_IMAGES);
+        if (images != videos) {
+            intent.setType(images ? "image/*" : "video/*");
+        }
+        if (allowMultiple) {
+            intent.putExtra(MediaStore.EXTRA_PICK_IMAGES_MAX, MediaStore.getPickImagesMaxLimit());
+        }
+        return intent;
+    }
