{
  "expo": {
    "name": "FreeTube",
    "slug": "FreeTube",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/youtube/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nima.freetube",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icons/youtube/foreground.png",
        "monochromeImage": "./assets/icons/youtube/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
